<UserControl x:Class="Ghozt.App.Shell.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Search targets, workspaces and governed actions. It never hides an action the operator lacks
      permission for: a palette that silently omits what you cannot do teaches you the action does
      not exist. Unavailable entries appear, disabled, with the reason.
    -->
    <Grid Background="{DynamicResource Surface.OverlaySoft}" MouseLeftButtonDown="OnDismiss">
        <Border Width="620" MaxHeight="440" VerticalAlignment="Top" Margin="0,120,0,0"
                Background="{DynamicResource Surface.Dialog}"
                BorderBrush="{DynamicResource Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Dialog}"
                MouseLeftButtonDown="OnSwallow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.6" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,14,16,12"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                   Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" />
                        <TextBox x:Name="Query" Grid.Column="1" Margin="10,0,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="15"
                                 TextChanged="OnQueryChanged"
                                 PreviewKeyDown="OnQueryKey"
                                 AutomationProperties.Name="Command palette search" />
                    </Grid>
                </Border>

                <ListBox x:Name="Results" Grid.Row="1" Margin="8"
                         Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="OnInvoke"
                         PreviewKeyDown="OnResultsKey">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                Padding="10,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.RowHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.SelectedStrong}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icon}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent.Text}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Type.MutedStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           Foreground="{DynamicResource Text.Muted}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="NoMatchesNotice" Grid.Row="1" Margin="24,32" HorizontalAlignment="Center"
                           Style="{StaticResource Type.CaptionStyle}" Foreground="{DynamicResource Text.Muted}"
                           Text="No matching workspaces, targets, or actions found."
                           Visibility="Collapsed" />

                <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource Surface.Inset}"
                        CornerRadius="0,0,19,19">
                    <TextBlock Style="{StaticResource Type.IdentifierStyle}"
                               Text="Enter to run · Esc to dismiss · unavailable actions are shown with their reason" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
