<UserControl x:Class="Ghozt.App.Workspaces.AlgorithmsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TabControl x:Name="AlgorithmsTabControl" AutomationProperties.AutomationId="AlgorithmsTabControl" Background="Transparent" BorderThickness="0">
        <!-- Tab 1: Deterministic & Metamorphic Invariants -->
        <TabItem Header="Invariant Proofs">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command Header -->
                <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Run Algorithm Suite"
                                    Click="OnRunSuite" x:Name="RunButton"
                                    ToolTip="Executes all deterministic algorithm invariant tests and analytical proofs"
                                    AutomationProperties.Name="Run algorithm invariant test suite" />
                            <Button Margin="8,0,0,0" Content="Export Dossier (.md)" Click="OnExportDossier"
                                    x:Name="ExportDossierButton" IsEnabled="False"
                                    ToolTip="Exports comprehensive mathematical verification dossier to %LOCALAPPDATA%\Capital-Iz\Ghozt\AlgorithmReports"
                                    AutomationProperties.Name="Export mathematical verification dossier" />
                            <Button Margin="8,0,0,0" Content="Seal to Evidence" Click="OnSealEvidence"
                                    x:Name="SealButton" IsEnabled="False"
                                    ToolTip="Records verified algorithm suite report into the SQLite evidence plane"
                                    AutomationProperties.Name="Seal verification report into evidence store" />
                            <ComboBox x:Name="DomainFilter" Width="170" Margin="14,0,0,0" Height="26"
                                      SelectionChanged="OnDomainFilterChanged"
                                      AutomationProperties.Name="Filter invariants by mathematical domain">
                                <ComboBoxItem Content="All Domains" IsSelected="True" />
                                <ComboBoxItem Content="Stochastic Estimators" />
                                <ComboBoxItem Content="Inferential Statistics" />
                                <ComboBoxItem Content="Information Theory" />
                                <ComboBoxItem Content="Graph Theory" />
                                <ComboBoxItem Content="Applied Cryptography" />
                                <ComboBoxItem Content="Numerical Stability" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SuiteSummaryText" Text="Click 'Run Algorithm Suite' to evaluate invariants"
                                       Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Results List -->
                <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ResultsPanel">
                        <Border x:Name="EmptyState" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Deterministic Algorithm &amp; Invariant Harness" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0" Text="Verify mathematical models, stochastic estimators, graph cycle prevention, and cryptographic proofs against analytical closed-form expectations."
                                           Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" MaxWidth="500" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Tab 2: Computational Complexity Scaling Assays (Patent §20) -->
        <TabItem Header="Complexity Assays">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command Header -->
                <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Run Complexity Assays"
                                    Click="OnRunComplexity" x:Name="RunComplexityButton"
                                    ToolTip="Executes empirical Big-O scaling benchmarks across variable sample sizes (N=100..5000)"
                                    AutomationProperties.Name="Run empirical complexity assays" />
                            <Button Margin="8,0,0,0" Content="Seal to Evidence" Click="OnSealComplexity"
                                    x:Name="SealComplexityButton" IsEnabled="False"
                                    ToolTip="Records complexity benchmark report into the evidence plane"
                                    AutomationProperties.Name="Seal complexity report to evidence" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ComplexitySummaryText" Text="Click 'Run Complexity Assays' to evaluate empirical Big-O scaling"
                                       Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Complexity Results List -->
                <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ComplexityPanel">
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Empirical Computational Complexity Assays" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0" Text="Benchmarks algorithmic latency across sample orders of magnitude (N=100..5000), computing the empirical scaling exponent alpha = ln(T2/T1)/ln(N2/N1) to prevent super-linear algorithmic drift."
                                           Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Tab 3: Delta-Debugging Input Minimiser (Patent §20 & §28) -->
        <TabItem Header="Delta-Debugging Lab">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command Header -->
                <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Run Input Minimisation"
                                    Click="OnRunMinimisation" x:Name="RunMinimiseButton"
                                    ToolTip="Isolates the 1-minimal reproducing subset of inputs triggering an algorithmic violation"
                                    AutomationProperties.Name="Run delta debugging input minimisation" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="MinimiseSummaryText" Text="Click 'Run Input Minimisation' to isolate minimal reproducing subset"
                                       Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimiser Results Body -->
                <ScrollViewer Grid.Row="1" x:Name="MinimiseScrollViewer" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Interactive Input Vector Configuration Card -->
                        <Border Margin="0,0,0,16" Padding="16" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.CardLarge}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="INTERACTIVE INPUT VECTOR &amp; FAILURE CRITERION" Style="{StaticResource Type.MicroLabelStyle}" />
                                        <TextBlock Text="Paste or edit failing input tokens/parameters (one per line). Delta Debugging will systematically isolate the 1-minimal subset triggering the failure."
                                                   Style="{StaticResource Type.CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="PRESET:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="VectorPresetPicker" Width="220" Height="26" SelectionChanged="OnPresetChanged"
                                                  AutomationProperties.Name="Select test vector preset">
                                            <ComboBoxItem Content="Unbalanced Recursion (12 items)" IsSelected="True" />
                                            <ComboBoxItem Content="Memory Leak Flags (16 items)" />
                                            <ComboBoxItem Content="Complex CLI Flags (14 items)" />
                                            <ComboBoxItem Content="Schema Properties (10 items)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="INPUT TOKENS (ONE PER LINE)" Style="{StaticResource Type.MicroLabelStyle}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CustomInputVectorText" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="11" Padding="8,6"
                                                 Background="{DynamicResource Surface.Deep}" Foreground="{DynamicResource Text.Primary}"
                                                 BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                                 ToolTip="Enter input elements separated by newlines"
                                                 AutomationProperties.Name="Custom input tokens editor" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="FAILURE CRITERION / ORACLE" Style="{StaticResource Type.MicroLabelStyle}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="FailureConditionPicker" Height="26" Margin="0,0,0,8" SelectionChanged="OnConditionChanged"
                                                  AutomationProperties.Name="Select failure criterion">
                                            <ComboBoxItem Content="Contains both 'trigger:' tokens" IsSelected="True" />
                                            <ComboBoxItem Content="Contains any 'trigger:' token" />
                                            <ComboBoxItem Content="Contains custom keyword" />
                                            <ComboBoxItem Content="Total token count >= 4" />
                                        </ComboBox>

                                        <TextBlock Text="CUSTOM KEYWORD (IF SELECTED)" Style="{StaticResource Type.MicroLabelStyle}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CustomKeywordText" Height="26" Margin="0,0,0,8" Text="unbalanced"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="11" Padding="6,2"
                                                 Background="{DynamicResource Surface.Deep}" Foreground="{DynamicResource Text.Primary}"
                                                 BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                                 AutomationProperties.Name="Custom keyword matching criterion" />

                                        <Button Content="Reset Vector" Height="26" Margin="0,4,0,0" Click="OnResetVector"
                                                ToolTip="Restore preset tokens" AutomationProperties.Name="Reset vector" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="MinimisePanel">
                            <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="24" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Algorithmic Input Minimisation (ddmin)" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,8,0,0" Text="Applies Delta Debugging to prune observational noise from complex input vectors, isolating the exact minimal critical inputs causing an algorithm failure or metamorphic contradiction."
                                               Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- Tab 4: Multi-Domain Audit Lab (Scientific Math, ML/Agentic AI, Android Mobile, Windows Desktop) -->
        <TabItem Header="Multi-Domain Audit Lab" x:Name="MultiDomainAuditTab" AutomationProperties.AutomationId="MultiDomainAuditTab">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Command Header -->
                <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Run Multi-Domain Audit"
                                    Click="OnRunMultiDomainAudit" x:Name="RunAuditButton"
                                    AutomationProperties.AutomationId="RunAuditButton"
                                    ToolTip="Executes deep forensic audit across the selected software/scientific domain"
                                    AutomationProperties.Name="Run multi-domain audit" />
                            <ComboBox x:Name="AuditDomainPicker" Width="260" Margin="10,0,0,0" Height="26"
                                      AutomationProperties.AutomationId="AuditDomainPicker"
                                      SelectionChanged="OnAuditDomainChanged"
                                      AutomationProperties.Name="Select audit domain">
                                <ComboBoxItem Content="Scientific &amp; Mathematical Engine" IsSelected="True" />
                                <ComboBoxItem Content="Machine Learning &amp; Agentic AI System" />
                                <ComboBoxItem Content="Android Mobile Emulator Runtime" />
                                <ComboBoxItem Content="Windows Desktop Native Application" />
                            </ComboBox>
                            <Button Margin="10,0,0,0" Content="Export Dossier (.md)" Click="OnExportAuditDossier"
                                    x:Name="ExportAuditDossierButton" IsEnabled="False"
                                    AutomationProperties.AutomationId="ExportAuditDossierButton"
                                    ToolTip="Exports comprehensive markdown dossier to the reports directory"
                                    AutomationProperties.Name="Export audit dossier" />
                            <Button Margin="8,0,0,0" Content="Seal to Evidence" Click="OnSealAuditEvidence"
                                    x:Name="SealAuditEvidenceButton" IsEnabled="False"
                                    AutomationProperties.AutomationId="SealAuditEvidenceButton"
                                    ToolTip="Records cryptographic audit report into the SQLite evidence vault"
                                    AutomationProperties.Name="Seal audit evidence" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="AuditSummaryText" Text="Select domain and click 'Run Multi-Domain Audit'"
                                       Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dedicated Interactive Domain Workbench Panels (Row 1) -->
                <Border Grid.Row="1" Padding="20,10" Background="{DynamicResource Surface.CardStrong}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Workbench 0: Scientific Math Parameters -->
                        <Grid x:Name="ScientificMathWorkbench" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SIMULATION PARAMETERS:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="dt:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MathDtBox" Text="0.05" Width="55" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Steps:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MathStepsBox" Text="200" Width="55" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Outliers:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MathOutliersBox" Text="0.05" Width="55" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Epsilon:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MathEpsilonBox" Text="1e-12" Width="70" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Content="Run Invariant Proofs" Click="OnRunConfigurableMathAudit" Height="24" Padding="10,0,10,0"
                                        ToolTip="Executes mathematical simulation with custom parameters" AutomationProperties.Name="Run parameterized mathematical proofs" />
                                <Button Content="Plot Energy Curve" Click="OnPlotMathTrajectory" Height="24" Padding="8,0,8,0" Margin="8,0,0,0"
                                        ToolTip="Plots 200-step Hamiltonian energy trajectory (Verlet vs Euler)" AutomationProperties.Name="Plot energy trajectory" />
                            </StackPanel>
                        </Grid>

                        <!-- Workbench 1: Machine Learning & Agentic AI Parameters -->
                        <Grid x:Name="AgenticAiWorkbench" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AGENTIC AI PARAMETERS:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Samples:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="AiSamplesBox" Text="250" Width="55" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Target Sharpe:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="AiSharpeBox" Text="2.0" Width="45" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Max Depth:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="AiDepthBox" Text="3" Width="40" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Content="Run AI Hardening Suite" Click="OnRunConfigurableAiAudit" Height="24" Padding="10,0,10,0" Margin="0,0,6,0"
                                        ToolTip="Executes AI validation with custom parameters" AutomationProperties.Name="Run parameterized AI hardening suite" />
                                <Button Content="Test Cycle Breaker" Click="OnTestAgentCycleBreaker" Height="24" Padding="8,0,8,0" Margin="0,0,6,0"
                                        ToolTip="Simulates a recursive tool calling cycle to test cycle governor" AutomationProperties.Name="Test agent cycle breaker" />
                                <Button Content="Trace Agent DAG" Click="OnTraceAgentDag" Height="24" Padding="8,0,8,0"
                                        ToolTip="Traces 5-layer autonomous agent execution and risk sovereignty DAG" AutomationProperties.Name="Trace agent DAG" />
                            </StackPanel>
                        </Grid>

                        <!-- Workbench 2: Android Mobile Emulator Parameters & Gestures -->
                        <Grid x:Name="MobileEmulatorWorkbench" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MOBILE CONTROLS:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="AVD:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MobileAvdBox" Text="Medium_Phone_API_36.1" Width="140" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Button Content="Query ADB" Click="OnQueryLiveAdbDevices" Height="24" Padding="8,0,8,0" Margin="0,0,6,0"
                                        ToolTip="Scans local ADB for active devices and emulators" AutomationProperties.Name="Query ADB devices" />
                                <Button Content="Toggle Airplane" Click="OnToggleAirplaneMode" Height="24" Padding="8,0,8,0" Margin="0,0,8,0"
                                        ToolTip="Toggles airplane mode on attached Android device" AutomationProperties.Name="Toggle airplane mode via ADB" />
                                <TextBlock Text="Filter:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MobileFilterBox" Text="*" Width="60" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Button Content="Fetch Logcat" Click="OnFetchLogcatStream" Height="24" Padding="8,0,8,0" Margin="0,0,10,0"
                                        ToolTip="Fetches live Logcat lines and scans for SQLite and RenderFlex violations" AutomationProperties.Name="Fetch live Logcat stream" />
                                <TextBlock Text="GESTURES:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Tap" Click="OnDispatchTapGesture" Height="24" Padding="6,0,6,0" Margin="0,0,4,0" ToolTip="Dispatches tap at (540, 1200)" AutomationProperties.Name="Dispatch tap gesture" />
                                <Button Content="Swipe" Click="OnDispatchSwipeGesture" Height="24" Padding="6,0,6,0" Margin="0,0,4,0" ToolTip="Dispatches swipe up" AutomationProperties.Name="Dispatch swipe gesture" />
                                <Button Content="Back" Click="OnDispatchBackKey" Height="24" Padding="6,0,6,0" Margin="0,0,4,0" ToolTip="Dispatches hardware Back key" AutomationProperties.Name="Dispatch back key" />
                                <Button Content="Home" Click="OnDispatchHomeKey" Height="24" Padding="6,0,6,0" ToolTip="Dispatches hardware Home key" AutomationProperties.Name="Dispatch home key" />
                            </StackPanel>
                        </Grid>

                        <!-- Workbench 3: Windows Desktop Native Parameters -->
                        <Grid x:Name="DesktopNativeWorkbench" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DESKTOP TARGET:" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Binary:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="DesktopBinaryBox" Text="Ghozt.exe" Width="120" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="PID:" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="DesktopPidBox" Text="Current" Width="60" Height="24" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Content="Sample Memory" Click="OnSampleDesktopMemory" Height="24" Padding="8,0,8,0" Margin="0,0,6,0"
                                        ToolTip="Samples real Working Set and Private Bytes" AutomationProperties.Name="Sample process memory" />
                                <Button Content="Scan Event Log" Click="OnScanWindowsEventLog" Height="24" Padding="8,0,8,0" Margin="0,0,6,0"
                                        ToolTip="Inspects Windows Application Event Log for crashes and exceptions" AutomationProperties.Name="Scan Windows Event Log" />
                                <Button Content="Verify DB WAL" Click="OnVerifySqliteDbWal" Height="24" Padding="8,0,8,0"
                                        ToolTip="Executes PRAGMA integrity_check against SQLite evidence store" AutomationProperties.Name="Verify SQLite WAL integrity" />
                                <Button Content="Inspect UI Tree" Click="OnInspectDesktopControls" Height="24" Padding="8,0,8,0" Margin="6,0,0,0"
                                        ToolTip="Inspects window HWND and enumerates primary UI automation controls" AutomationProperties.Name="Inspect desktop UI controls" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Audit Results List (Row 2) -->
                <ScrollViewer Grid.Row="2" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AuditResultsPanel">
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Universal Multi-Domain Forensic Audit Engine" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0" Text="Deep forensic verification across First-Principles Scientific Computing, Machine Learning &amp; Agentic AI Systems, Android Mobile Emulators, and Windows Desktop Applications."
                                           Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" MaxWidth="600" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Embedded Live Execution Console (Row 3) -->
                <Border Grid.Row="3" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE AUDIT &amp; TELEMETRY STREAM CONSOLE" Style="{StaticResource Type.MicroLabelStyle}" Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConsoleStatusText" Text="Idle · Ready for audit execution" Style="{StaticResource Type.CaptionStyle}" Foreground="{DynamicResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Clear Console" Height="20" Padding="6,0,6,0" FontSize="10" Click="OnClearAuditConsole"
                                    ToolTip="Clears console telemetry output" AutomationProperties.Name="Clear audit console" />
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="AuditConsoleTextBox" Height="90" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                 Background="{DynamicResource Surface.Base}" Foreground="{DynamicResource Text.Primary}"
                                 BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" Padding="8,4"
                                 Text="[00:00:00] Ghozt Universal Multi-Domain Audit Engine initialized. Ready for commands.&#x0a;" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
