<UserControl x:Class="Ghozt.App.Workspaces.AlgorithmsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Header -->
        <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" Content="Run Algorithm Suite"
                            Click="OnRunSuite" x:Name="RunButton"
                            ToolTip="Executes all deterministic algorithm invariant tests and analytical proofs"
                            AutomationProperties.Name="Run algorithm invariant test suite" />
                    <Button Margin="8,0,0,0" Content="Seal to Evidence" Click="OnSealEvidence"
                            x:Name="SealButton" IsEnabled="False"
                            ToolTip="Records verified algorithm suite report into the SQLite evidence plane"
                            AutomationProperties.Name="Seal verification report into evidence store" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SuiteSummaryText" Text="Click 'Run Algorithm Suite' to evaluate invariants"
                               Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results List -->
        <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel">
                <Border x:Name="EmptyState" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="24" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Deterministic Algorithm &amp; Invariant Harness" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" Text="Verify mathematical models, stochastic estimators, graph cycle prevention, and cryptographic proofs against analytical closed-form expectations."
                                   Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" MaxWidth="500" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
