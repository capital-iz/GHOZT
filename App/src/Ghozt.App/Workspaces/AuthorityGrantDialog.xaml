<Window x:Class="Ghozt.App.Workspaces.AuthorityGrantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="580" MaxHeight="800"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Execution Authority Grant">

    <Border Background="{DynamicResource Surface.Dialog}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Padding="24,20,24,16"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag">
                <StackPanel>
                    <TextBlock Text="Execution Authority Grant (Patent §35 &amp; Table 70)"
                               Style="{StaticResource Type.SectionStyle}"
                               Foreground="{DynamicResource Authority.Clearance}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Type.CaptionStyle}"
                               Text="Issues a cryptographically signed authority grant enforcing isolation levels L0 to L5. Every privileged action requires an active unexpired grant." />
                </StackPanel>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" Padding="24,18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="TARGET" />
                            <TextBlock x:Name="TargetNameText" Style="{StaticResource Type.HeadingStyle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="TargetIdText" Style="{StaticResource Type.IdentifierStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="ACTIVE ISOLATION CEILING" />
                            <TextBlock x:Name="CurrentLevelText" Style="{StaticResource Type.MonoStyle}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock x:Name="CurrentGrantIdText" Style="{StaticResource Type.CaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,6,0,14" />

                    <!-- Form Controls -->
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="EXECUTION ISOLATION LEVEL (TABLE 70)" />
                    <ComboBox x:Name="IsolationLevelBox" SelectionChanged="OnFormChanged" Height="28" Margin="0,2,0,12">
                        <ComboBoxItem Content="L0_Observe — Passive inspection, zero state mutations" IsSelected="True" Tag="L0_Observe" />
                        <ComboBoxItem Content="L1_ControlledInteraction — Bounded UI driving and inputs" Tag="L1_ControlledInteraction" />
                        <ComboBoxItem Content="L2_StateChanging — Read/Write data, create temporary records" Tag="L2_StateChanging" />
                        <ComboBoxItem Content="L3_DestructiveChaos — Fault injection, resource disruption" Tag="L3_DestructiveChaos" />
                        <ComboBoxItem Content="L4_CodeModification — Automated patch application" Tag="L4_CodeModification" />
                        <ComboBoxItem Content="L5_ProductionObservation — Live cluster observation" Tag="L5_ProductionObservation" />
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="DATA SENSITIVITY TIER" />
                            <ComboBox x:Name="SensitivityBox" SelectionChanged="OnFormChanged" Height="28" Margin="0,2,0,0">
                                <ComboBoxItem Content="Public — No PII or credentials" IsSelected="True" Tag="Public" />
                                <ComboBoxItem Content="Internal — Standard operational data" Tag="Internal" />
                                <ComboBoxItem Content="Confidential — Redacted tokens only" Tag="Confidential" />
                                <ComboBoxItem Content="Restricted — High security enclaves" Tag="Restricted" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="GRANT DURATION" />
                            <ComboBox x:Name="DurationBox" SelectionChanged="OnFormChanged" Height="28" Margin="0,2,0,0">
                                <ComboBoxItem Content="1 Hour (Temporary session)" Tag="1" />
                                <ComboBoxItem Content="8 Hours (Working day)" IsSelected="True" Tag="8" />
                                <ComboBoxItem Content="24 Hours (Full test sweep)" Tag="24" />
                                <ComboBoxItem Content="7 Days (Continuous soak)" Tag="168" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="OPERATOR / ACTOR" />
                            <TextBox x:Name="ActorBox" TextChanged="OnFormChanged" Height="28" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="APPROVER / SIGNER" />
                            <TextBox x:Name="ApproverBox" TextChanged="OnFormChanged" Height="28" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="SCOPE &amp; PURPOSE JUSTIFICATION" />
                    <TextBox x:Name="JustificationBox" TextChanged="OnFormChanged" Height="52" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,2,0,12" />

                    <!-- Live Token Preview -->
                    <Border Background="{DynamicResource Surface.Inset}" Padding="12" CornerRadius="{StaticResource Radius.Card}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="CRYPTOGRAPHIC SEAL PREVIEW" Style="{StaticResource Type.MicroLabelStyle}" Foreground="{DynamicResource Authority.Clearance}" />
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Token: " Style="{StaticResource Type.IdentifierStyle}" />
                                <TextBlock x:Name="PreviewTokenText" Grid.Column="1" Style="{StaticResource Type.MonoStyle}" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audit Signature: " Style="{StaticResource Type.IdentifierStyle}" />
                                <TextBlock x:Name="PreviewSigText" Grid.Column="1" Style="{StaticResource Type.MonoStyle}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Muted}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Border Grid.Row="2" Padding="24,14,24,18"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Content="Revoke to L0" Click="OnRevoke" HorizontalAlignment="Left"
                            ToolTip="Immediately revokes all active authority and locks target into L0 Observe mode" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCancel" Margin="0,0,10,0" IsCancel="True" />
                        <Button x:Name="IssueButton" Content="Issue Authority Grant" Click="OnIssue"
                                Style="{StaticResource Button.Primary}" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
