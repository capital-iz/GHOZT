<Window x:Class="Ghozt.App.Workspaces.DestructiveGate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Confirm">

    <!--
      A typed confirmation, not a yes/no prompt.

      The blueprint requires a destructive action to state its exact target and effect and to be
      confirmed deliberately. A single OK button on an irreversible action is a speed bump; typing
      the subject's own name is the smallest gate that actually requires the operator to have read
      what they are about to destroy.
    -->
    <Border Background="{DynamicResource Surface.Dialog}"
            BorderBrush="{DynamicResource State.Critical}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" Background="{DynamicResource State.CriticalSoft}"
                        BorderBrush="{DynamicResource State.Critical}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.SealChamfer}">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                               Foreground="{DynamicResource State.Critical}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Type.SectionStyle}"
                           Foreground="{DynamicResource State.Critical}" />
            </StackPanel>

            <TextBlock x:Name="EffectText" Margin="0,16,0,0" Style="{StaticResource Type.BodyStyle}" />

            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,20,0,4"
                       x:Name="PromptLabel" />

            <TextBox x:Name="Confirmation" TextChanged="OnTyped"
                     AutomationProperties.Name="Type the name to confirm" />

            <TextBlock x:Name="Mismatch" Margin="0,6,0,0" Style="{StaticResource Type.MutedStyle}"
                       Foreground="{DynamicResource State.Warning}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="90" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Destructive}"
                        Margin="10,0,0,0" MinWidth="140" IsEnabled="False" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
