<UserControl x:Class="Ghozt.App.Workspaces.FaultsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Ghozt.App.Shell">

    <UserControl.Resources>
        <shell:SeverityBrushConverter x:Key="SeverityBrush" />
        <shell:ReproducibilityConverter x:Key="Repro" />
        <shell:IsEmptyConverter x:Key="IsEmpty" />
        <shell:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20,12" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" Content="Attempt reproduction"
                            Click="OnReproduce" x:Name="ReproButton" IsEnabled="False" Margin="0,0,8,6"
                            ToolTip="Re-runs the check that produced this finding and records whether it recurred"
                            AutomationProperties.Name="Attempt to reproduce the selected finding" />
                    <Button Margin="0,0,8,6" Content="Advance maturity" Click="OnAdvance"
                            x:Name="AdvanceButton" IsEnabled="False"
                            ToolTip="Moves the finding to its next lifecycle state"
                            AutomationProperties.Name="Advance the finding's maturity" />
                    <Button Margin="0,0,8,6" Content="Investigate Cause" Click="OnInvestigateCausal"
                            x:Name="CausalButton" IsEnabled="False"
                            ToolTip="Tests counterfactual interventions to isolate the root causal mechanism"
                            AutomationProperties.Name="Run counterfactual causal analysis" />
                    <Button Margin="0,0,8,6" Content="Generate Fix Brief" Click="OnGenerateFixBrief"
                            x:Name="FixBriefButton" IsEnabled="False"
                            ToolTip="Generates a bounded repair contract with scope constraints and rejection rules"
                            AutomationProperties.Name="Generate bounded Fix Brief" />
                    <Button Margin="0,0,8,6" Content="Verify Repair" Click="OnVerifyRepair"
                            x:Name="VerifyRepairButton" IsEnabled="False"
                            ToolTip="Formally verifies code repair against Fix Brief and regression guards (Patent §30)"
                            AutomationProperties.Name="Verify bounded repair" />
                    <Button Margin="0,0,8,6" Content="Replay Trace" Click="OnReplayFault"
                            x:Name="ReplayFaultButton" IsEnabled="False"
                            ToolTip="Opens Replay workspace to step through the execution trace that caused this deviation"
                            AutomationProperties.Name="Replay execution trace of finding" />
                    <Button Margin="0,0,8,6" Content="Locate on Map" Click="OnLocateOnStateMap"
                            x:Name="LocateMapButton" IsEnabled="False"
                            ToolTip="Opens State Map and highlights the lattice node where this fault was detected"
                            AutomationProperties.Name="Locate finding on State Map" />
                    <Button Margin="0,0,8,6" Content="View Evidence" Click="OnViewEvidence"
                            x:Name="ViewEvidenceButton" IsEnabled="False"
                            ToolTip="Opens Evidence workspace and displays artifacts captured for this finding"
                            AutomationProperties.Name="View evidence for finding" />
                    <Button Margin="0,0,8,6" Content="Assign to me" Click="OnAssign"
                            x:Name="AssignButton" IsEnabled="False"
                            AutomationProperties.Name="Assign the finding to the current operator" />
                    <Button Margin="0,0,8,6" Content="Export Bug Report" Click="OnExportBugReport"
                            x:Name="ExportBugReportButton" IsEnabled="False"
                            ToolTip="Formats and exports selected defect dossier as Markdown/GitHub Issue contract to clipboard"
                            AutomationProperties.Name="Export bug report as Markdown" />
                </WrapPanel>

                <!-- Multi-Predicate Search & Filter Bar -->
                <Border Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="SEARCH" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="SearchBox" Width="170" Height="26" Margin="0,0,12,0" TextChanged="OnFilterChanged"
                                     ToolTip="Filter findings by title, description, or fingerprint" AutomationProperties.Name="Search findings" />

                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="SEVERITY" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="SeverityFilter" Width="135" Height="26" Margin="0,0,12,0" SelectionChanged="OnFilterChanged"
                                      AutomationProperties.Name="Filter by severity">
                                <ComboBoxItem Content="All Severities" IsSelected="True" />
                                <ComboBoxItem Content="Blocker" />
                                <ComboBoxItem Content="Critical" />
                                <ComboBoxItem Content="Major" />
                                <ComboBoxItem Content="Minor" />
                                <ComboBoxItem Content="Cosmetic" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="STATE" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="StateFilter" Width="140" Height="26" Margin="0,0,12,0" SelectionChanged="OnFilterChanged"
                                      AutomationProperties.Name="Filter by lifecycle state">
                                <ComboBoxItem Content="All States" IsSelected="True" />
                                <ComboBoxItem Content="New" />
                                <ComboBoxItem Content="Phantom" />
                                <ComboBoxItem Content="Confirming" />
                                <ComboBoxItem Content="Reproduced" />
                                <ComboBoxItem Content="CauseSupported" />
                                <ComboBoxItem Content="FixReady" />
                                <ComboBoxItem Content="ReTest" />
                                <ComboBoxItem Content="Verified" />
                                <ComboBoxItem Content="Waived" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="QueueStatsText" Text="0 findings" Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource Type.MutedStyle}"
                           Text="Findings cannot be closed in bulk. Each verdict needs its own evidence, and a queue-wide sweep of the backlog is how untested scope gets recorded as passing." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Fault Queue List -->
            <Grid Grid.Column="0">
                <ListBox x:Name="Queue" Background="Transparent" BorderThickness="0"
                         Padding="20,14"
                         SelectionChanged="OnSelect"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Fault queue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{DynamicResource Surface.Card}"
                                                BorderBrush="{DynamicResource Border.Card}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.CardStrongHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.BorderStrong}" />
                                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The severity rail. Two channels: the bar and the badge text. -->
                                <Border Width="3" Margin="0,0,12,0" CornerRadius="2"
                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Type.HeadingStyle}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Type.IdentifierStyle}" />
                                        <TextBlock Text="·" Margin="6,0" Style="{StaticResource Type.IdentifierStyle}" />
                                        <TextBlock Text="{Binding Maturity}" Style="{StaticResource Type.IdentifierStyle}" />
                                        <TextBlock Text="·" Margin="6,0" Style="{StaticResource Type.IdentifierStyle}" />
                                        <TextBlock Style="{StaticResource Type.IdentifierStyle}">
                                            <Run Text="reproduces" />
                                            <Run Text="{Binding Reproducibility, Converter={StaticResource Repro}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Phantom badge -->
                                    <Border Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left"
                                            CornerRadius="{StaticResource Radius.Chip}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Ghozt.CounterfactualBorder}"
                                            Visibility="{Binding IsPhantom, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="PHANTOM — intermittent, cause unconfirmed"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ghozt.Counterfactual}" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Top" Padding="7,3"
                                        CornerRadius="{StaticResource Radius.Chip}" BorderThickness="1"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                    <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Emptiness notification -->
                <Border Style="{StaticResource Surface.EmptySlot}" MaxWidth="560" Margin="0,40,0,0"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        x:Name="EmptyPanel">
                    <StackPanel>
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" FontSize="22"
                                   Foreground="{DynamicResource State.Verified}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource Type.SectionStyle}" />
                        <TextBlock x:Name="EmptyBody" Margin="0,8,0,0" TextAlignment="Center"
                                   Style="{StaticResource Type.CaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Forensic Dossier & Causal / Fix Brief Drawer -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource Surface.Deep}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DossierPanel">
                        <TextBlock Text="FORENSIC INVESTIGATION" Style="{StaticResource Type.SectionStyle}" />
                        <TextBlock Text="Counterfactual causal hypothesis and bounded repair contract."
                                   Style="{StaticResource Type.CaptionStyle}" Margin="0,4,0,16" />

                        <!-- Placeholder when no finding selected -->
                        <Border x:Name="NoSelectionBox" Style="{StaticResource Surface.EmptySlot}" Padding="16" Margin="0,20,0,0">
                            <TextBlock Text="Select a finding to inspect causal mechanisms and generate Fix Briefs."
                                       Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" />
                        </Border>

                        <!-- 10-State Maturity Lifecycle Card (Patent Table 45) -->
                        <Border x:Name="MaturityCard" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                               Foreground="{DynamicResource State.Verified}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Maturity Lifecycle (Table 45)" Style="{StaticResource Type.HeadingStyle}" FontSize="13" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <Border Padding="8,3" CornerRadius="{StaticResource Radius.Chip}" Background="{DynamicResource Surface.Elevated}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                        <TextBlock x:Name="MaturityBadgeText" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Accent.Text}" />
                                    </Border>
                                    <TextBlock x:Name="MaturityStepCountText" Style="{StaticResource Type.IdentifierStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock x:Name="MaturityPreconditionText" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Advance State" Click="OnAdvance" Margin="0,0,6,0" ToolTip="Advance to next verified lifecycle state" />
                                    <Button Content="Waive Risk" Click="OnWaiveFinding" Margin="0,0,6,0" ToolTip="Formally waive finding under named authority" />
                                    <Button Content="Reject" Click="OnRejectFinding" ToolTip="Mark as rejected / test error" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cross-Workspace Forensic Navigation Card -->
                        <Border x:Name="CrossNavCard" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Replay Trace" Click="OnReplayFault" Margin="0,0,8,6" Padding="10,4" ToolTip="Step through sweep trace in Replay" />
                                    <Button Content="Locate on Map" Click="OnLocateOnStateMap" Margin="0,0,8,6" Padding="10,4" ToolTip="Center and highlight state in State Map" />
                                    <Button Content="View Evidence" Click="OnViewEvidence" Margin="0,0,8,6" Padding="10,4" ToolTip="Inspect raw payloads in Evidence" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Composite Fault Fingerprint Card (Patent Table 46 & 47) -->
                        <Border x:Name="FingerprintCard" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                               Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Fault Fingerprint (Table 46)" Style="{StaticResource Type.HeadingStyle}" FontSize="13" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                    <TextBlock x:Name="FingerprintIdText" Style="{StaticResource Type.MonoStyle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" />
                                    <Border x:Name="DuplicateBadge" Margin="8,0,0,0" Padding="6,2" CornerRadius="{StaticResource Radius.Chip}" Background="{DynamicResource Surface.Elevated}">
                                        <TextBlock x:Name="DuplicateBadgeText" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="DuplicateRationaleText" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" Margin="0,2,0,8" />

                                <TextBlock Text="7-Feature Decomposition:" FontWeight="SemiBold" FontSize="10" Margin="0,6,0,4" Foreground="{DynamicResource Text.Secondary}" />
                                <StackPanel x:Name="FingerprintFeaturesList" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Copy Fingerprint" Click="OnCopyFingerprint" Margin="0,0,6,0" ToolTip="Copy 32-character SHA-256 fingerprint digest" />
                                    <Button Content="Export Issue (GitHub)" Click="OnExportGitHubIssue" Margin="0,0,6,0" ToolTip="Formats GitHub Issue Markdown with Table 46 deduplication token" />
                                    <Button Content="Export Issue (Jira)" Click="OnExportJiraIssue" ToolTip="Formats Jira Cloud JSON with Table 46 deduplication token" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Causal Forensics Card -->
                        <Border x:Name="CausalCard" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                               Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Causal Hypothesis" Style="{StaticResource Type.HeadingStyle}" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="HypothesisIdText" Style="{StaticResource Type.IdentifierStyle}" Foreground="{DynamicResource Text.Muted}" />
                                <TextBlock x:Name="HypothesisClaimText" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="HypothesisMechanismText" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <TextBlock Text="Counterfactual Interventions:" FontWeight="SemiBold" FontSize="10" Margin="0,10,0,4"
                                           Foreground="{DynamicResource Text.Secondary}" />
                                <StackPanel x:Name="InterventionsList" />

                                <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                        HorizontalAlignment="Left" Background="{DynamicResource Surface.Elevated}">
                                    <TextBlock x:Name="CausalStatusText" Style="{StaticResource Type.IdentifierStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fix Brief Card -->
                        <Border x:Name="FixBriefCard" Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                               Foreground="{DynamicResource Authority.Clearance}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Fix Brief Contract" Style="{StaticResource Type.HeadingStyle}" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="FixBriefIdText" Style="{StaticResource Type.IdentifierStyle}" Foreground="{DynamicResource Authority.Clearance}" />
                                <TextBlock x:Name="FixBriefTitleText" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <TextBlock Text="Allowed Scope:" FontWeight="SemiBold" FontSize="10" Margin="0,8,0,2" Foreground="{DynamicResource Text.Secondary}" />
                                <TextBlock x:Name="FixBriefScopeText" Style="{StaticResource Type.MonoStyle}" FontSize="10" TextWrapping="Wrap" />

                                <TextBlock Text="Regression Guard:" FontWeight="SemiBold" FontSize="10" Margin="0,8,0,2" Foreground="{DynamicResource Text.Secondary}" />
                                <TextBlock x:Name="FixBriefGuardText" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Copy Markdown" Click="OnCopyFixBrief"
                                            Margin="0,0,6,0" ToolTip="Copy Fix Brief contract to clipboard" />
                                    <Button Content="Export (.md)" Click="OnExportFixBrief"
                                            Margin="0,0,6,0" ToolTip="Export Fix Brief contract markdown file to disk" />
                                    <Button Content="Derive Guard" Click="OnDeriveGuard"
                                            ToolTip="Derive an automated regression guard from this finding" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
