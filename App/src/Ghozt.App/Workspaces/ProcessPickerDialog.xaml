<Window x:Class="Ghozt.App.Workspaces.ProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Attach Running Process">

    <Border Background="{DynamicResource Surface.Dialog}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,20,24,16"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag">
                <StackPanel>
                    <TextBlock Text="Attach Running Process" Style="{StaticResource Type.SectionStyle}"
                               Foreground="{DynamicResource Accent.Text}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Type.CaptionStyle}"
                               Text="Select an active desktop application on this machine to attach Ghozt's UI Automation supervisor and blackbox engine." />
                </StackPanel>
            </Border>

            <!-- Search Filter -->
            <Border Grid.Row="1" Padding="24,12,24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="28" Padding="8,4"
                             TextChanged="OnSearchChanged"
                             ToolTip="Filter by process name, window title, or PID"
                             AutomationProperties.Name="Filter processes" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Refresh"
                            Click="OnRefresh" Padding="12,0" Height="28"
                            AutomationProperties.Name="Refresh running processes" />
                </Grid>
            </Border>

            <!-- Process List -->
            <Border Grid.Row="2" Padding="24,4,24,12">
                <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="1"
                         BorderBrush="{DynamicResource Border.Subtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnItemDoubleClick"
                         AutomationProperties.Name="Running desktop processes">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{DynamicResource Surface.Card}"
                                                BorderBrush="{DynamicResource Border.Card}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.CardStrongHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent.BorderStrong}" />
                                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding MainWindowTitle}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Type.CaptionStyle}"
                                               Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Text}" />
                                        <Run Text=" · PID " />
                                        <Run Text="{Binding ProcessId}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding ExecutablePath}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,2"
                                        CornerRadius="{StaticResource Radius.Chamfer}"
                                        Background="{DynamicResource Ghozt.LiveSoft}" BorderBrush="{DynamicResource Ghozt.LiveBorder}"
                                        BorderThickness="1">
                                    <TextBlock Text="RUNNING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Ghozt.Live}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer Buttons -->
            <Border Grid.Row="3" Padding="24,14" BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="0,1,0,0" Background="{DynamicResource Surface.Inset}">
                <Grid>
                    <TextBlock x:Name="StatusCount" Style="{StaticResource Type.MutedStyle}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCancel" Width="90" IsCancel="True" />
                        <Button x:Name="AttachButton" Style="{StaticResource Button.Primary}"
                                Margin="8,0,0,0" Content="Attach" Click="OnAttach"
                                Width="110" IsDefault="True" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
