<UserControl x:Class="Ghozt.App.Workspaces.ReplayWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Ghozt.App.Shell">

    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <shell:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <shell:SeverityBrushConverter x:Key="SeverityBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar: Sweep Picker, Step Navigation, Play/Pause Scrubber -->
        <Border Padding="20,10" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Sweep Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="SWEEP RUN" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="SweepPicker" MinWidth="220" Height="28" SelectionChanged="OnSweepSelected"
                              AutomationProperties.Name="Select sweep run for replay">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text=" · " Style="{StaticResource Type.CaptionStyle}" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Type.CaptionStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Margin="10,0,0,0" Content="Refresh" Click="OnRefreshClicked" Height="28" Padding="10,0"
                            ToolTip="Reload completed sweeps from evidence database"
                            AutomationProperties.Name="Refresh sweeps" />

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                    <!-- Compare Run Selector -->
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="COMPARE" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ComparePicker" MinWidth="180" Height="28" SelectionChanged="OnCompareSelected"
                              ToolTip="Select secondary baseline sweep run for comparative diffing"
                              AutomationProperties.Name="Select comparison sweep">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.BodyStyle}" />
                                    <TextBlock Text=" · " Style="{StaticResource Type.CaptionStyle}" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Type.CaptionStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Center: Scrubber & Timeline Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="FirstBtn" Content="|&#x25C0;" Width="32" Height="28" Margin="2,0" Click="OnFirstStep"
                            ToolTip="Jump to first step" AutomationProperties.Name="First step" />
                    <Button x:Name="PrevBtn" Content="&#x25C0;" Width="32" Height="28" Margin="2,0" Click="OnPrevStep"
                            ToolTip="Previous step" AutomationProperties.Name="Previous step" />
                    <Button x:Name="PlayPauseBtn" Content="Play" Width="68" Height="28" Margin="4,0" Click="OnPlayPause"
                            ToolTip="Play/Pause automatic timeline playback" AutomationProperties.Name="Play or pause replay" />
                    <Button x:Name="NextBtn" Content="&#x25B6;" Width="32" Height="28" Margin="2,0" Click="OnNextStep"
                            ToolTip="Next step" AutomationProperties.Name="Next step" />
                    <Button x:Name="LastBtn" Content="&#x25B6;|" Width="32" Height="28" Margin="2,0" Click="OnLastStep"
                            ToolTip="Jump to last step" AutomationProperties.Name="Last step" />

                    <Slider x:Name="StepSlider" Width="200" Margin="14,0,8,0" Minimum="0" Maximum="0" SmallChange="1" LargeChange="1"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderValueChanged"
                            VerticalAlignment="Center" AutomationProperties.Name="Timeline scrubber slider" />

                    <TextBlock x:Name="StepCounterText" Text="0 / 0" Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Right: Outcome & Verification Seal Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="OutcomeBadge" Padding="10,4" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Card}">
                        <TextBlock x:Name="OutcomeText" Text="NO SWEEP SELECTED" Style="{StaticResource Type.MicroLabelStyle}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Body: Split View -->
        <Grid Grid.Row="1">
            <!-- Empty State when no sweep or no steps exist -->
            <StackPanel x:Name="EmptyNotice" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="42" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Text.Muted}" />
                <TextBlock Text="No Replay Data Available" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Select a completed sweep run above, or execute an Autonomous E2E examination in the Sweep workspace to record black-box screenshots and step telemetry."
                           Style="{StaticResource Type.CaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Active Replay Content -->
            <Grid x:Name="ReplayContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Black-box Screenshot & Visual Surface -->
                <Border Margin="16,14,8,14" Background="{DynamicResource Surface.Deep}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Screenshot Header Overlay -->
                        <Border Padding="12,8" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepActionHeader" Text="Step 0: Initial State" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text=" · " Style="{StaticResource Type.CaptionStyle}" />
                                    <TextBlock x:Name="StepTimestampText" Text="" Style="{StaticResource Type.CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="SEAL: " Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SealShaText" Text="" Style="{StaticResource Type.MonoStyle}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Screenshot & Telemetry Canvas -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="350">
                                <Image x:Name="ScreenshotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Non-Visual Telemetry Frame Viewer -->
                                <Border x:Name="NonVisualPayloadCard" Background="{DynamicResource Surface.Deep}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="6"
                                        Padding="16" Margin="16" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="0,0,0,12" Padding="8,4" HorizontalAlignment="Left"
                                                Background="{DynamicResource Surface.CardFaint}" BorderBrush="{DynamicResource Border.Subtle}"
                                                BorderThickness="1" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="TELEMETRY FRAME" Style="{StaticResource Type.MicroLabelStyle}" Foreground="{DynamicResource Accent.Text}" />
                                                <TextBlock Text=" · " Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock x:Name="PayloadKindText" Text="Kind: Event" Style="{StaticResource Type.CaptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBox Grid.Row="1" x:Name="PayloadTextBox" IsReadOnly="True"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource Text.Secondary}"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="NoScreenshotNotice" Text="No visual frame captured for this step."
                                           Style="{StaticResource Type.CaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Screenshot Footer: State signature & transition edge -->
                        <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="STATE: " Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateIdText" Text="state:root" Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" />
                                <TextBlock Text=" · " Style="{StaticResource Type.CaptionStyle}" />
                                <TextBlock x:Name="TransitionText" Text="Target launched" Style="{StaticResource Type.CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Column: Inspector Tabs (Action Details, Oracles, UI Tree) -->
                <Border Grid.Column="1" Margin="8,14,16,14" Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="6">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- Tab 1: Step Details -->
                        <TabItem Header="Action &amp; Telemetry">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ACTION EXECUTED" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock x:Name="ActionDescText" Text="None" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ActionTargetText" Margin="0,4,0,0" Text="Target: None" Style="{StaticResource Type.CaptionStyle}" />
                                            <TextBlock x:Name="ActionKindText" Margin="0,2,0,0" Text="Kind: None" Style="{StaticResource Type.CaptionStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="EXECUTION OUTCOME" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock x:Name="ActionResultStatus" Text="Success" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ActionResultDuration" Margin="0,4,0,0" Text="Duration: 0ms" Style="{StaticResource Type.MonoStyle}" />
                                            <TextBlock x:Name="ActionResultError" Margin="0,4,0,0" Text="" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" Foreground="{DynamicResource State.Critical}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="CRYPTOGRAPHIC EVIDENCE" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Screenshot SHA-256:" Style="{StaticResource Type.CaptionStyle}" />
                                            <TextBlock x:Name="EvidenceScreenshotSha" Text="" Style="{StaticResource Type.MonoStyle}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6" />
                                            <TextBlock Text="UI Tree SHA-256:" Style="{StaticResource Type.CaptionStyle}" />
                                            <TextBlock x:Name="EvidenceTreeSha" Text="" Style="{StaticResource Type.MonoStyle}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="CROSS-WORKSPACE ACTIONS" Style="{StaticResource Type.MicroLabelStyle}" Margin="0,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Triage in Faults" Click="OnTriageInFaults" Margin="0,0,6,0" Padding="8,4" FontSize="10" ToolTip="Jump to linked fault finding in Faults workspace" />
                                        <Button Content="Inspect State" Click="OnInspectInStateMap" Margin="0,0,6,0" Padding="8,4" FontSize="10" ToolTip="Locate state in State Map workspace" />
                                        <Button Content="View Evidence" Click="OnInspectEvidence" Padding="8,4" FontSize="10" ToolTip="Open black-box artefact in Evidence workspace" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Oracle Invariants & Deviations -->
                        <TabItem Header="Oracles &amp; Deviations">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="STEP ORACLE VERDICTS" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <ItemsControl x:Name="OracleList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <Border Grid.Column="1" Padding="6,2" CornerRadius="3"
                                                                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                                                <TextBlock Text="{Binding Severity}" Foreground="Black" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Expected}" Margin="0,4,0,0" Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Actual}" Margin="0,2,0,0" Style="{StaticResource Type.CaptionStyle}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource State.Critical}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="AllOraclesPassedText" Text="All automated oracles passed for this step."
                                               Style="{StaticResource Type.CaptionStyle}" Margin="0,8,0,0" Foreground="{DynamicResource State.Verified}" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: UI Element Snapshot -->
                        <TabItem Header="UI Tree Hierarchy">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="SNAPSHOT ELEMENTS" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <TreeView x:Name="UiElementTree" Margin="0,6,0,0" Background="Transparent" BorderThickness="0">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding ControlType}" Style="{StaticResource Type.MicroLabelStyle}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Id, StringFormat=' (id: {0})'}" Style="{StaticResource Type.CaptionStyle}" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <TextBlock x:Name="NoTreeText" Text="No UI tree recorded for this step." Style="{StaticResource Type.CaptionStyle}" Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: Run Comparison -->
                        <TabItem Header="Run Comparison">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="RUN COMPARISON FORENSICS" Style="{StaticResource Type.MicroLabelStyle}" />

                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock x:Name="ComparisonHeader" Text="Select a comparison sweep above" Style="{StaticResource Type.BodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ComparisonSubheader" Margin="0,4,0,0" Text="Compares step count, execution time, and deviation emergence between runs." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="EXECUTION METRICS COMPARISON" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Run A (Active):" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="RunAMetricsText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Run B (Baseline):" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="RunBMetricsText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step Count Delta:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="StepDeltaText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Duration Delta:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="DurationDeltaText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="DEVIATION DIVERGENCE &amp; REGRESSIONS" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock x:Name="ComparisonDivergenceText" Text="No baseline run selected for comparison." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="FIRST STEP DIVERGENCE POINT" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock x:Name="DivergencePointText" Text="No step divergence detected between runs." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                            <Button x:Name="JumpDivergenceBtn" Content="Jump to Divergence Step" Margin="0,8,0,0" Height="28" Padding="10,0"
                                                    Click="OnJumpToDivergenceClicked" Visibility="Collapsed"
                                                    ToolTip="Scroll timeline scrubber directly to the divergence step" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 5: Sequence Minimiser (Patent §28) -->
                        <TabItem Header="Sequence Minimiser">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="REPRODUCTION SEQUENCE MINIMISATION" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <TextBlock Text="Applies Delta Debugging (ddmin) to isolate the minimal critical path of state transitions reproducing the fault fingerprint while eliminating observational noise."
                                               Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />

                                    <Button x:Name="MinimiseBtn" Content="Minimise Failing Sequence" Click="OnMinimiseSequenceClicked"
                                            Height="28" Padding="14,0" HorizontalAlignment="Left" Margin="0,0,0,12"
                                            ToolTip="Reduce action sequence to minimal causal subset (Patent §28)" />

                                    <TextBlock Text="MINIMISATION METRICS" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Original Steps:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="MinOriginalStepsText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Minimal Critical Steps:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="MinReducedStepsText" Text="—" Style="{StaticResource Type.MonoStyle}" Foreground="{DynamicResource State.Verified}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Noise Elimination Ratio:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="MinReductionPercentText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <TextBlock x:Name="MinimisationDetailText" Margin="0,6,0,0" Text="Click above to compute minimal causal subsequence." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="MINIMAL CRITICAL ACTION SEQUENCE" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <ItemsControl x:Name="MinimisedStepsList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Padding="6,2" CornerRadius="3" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding StepIndex, StringFormat='Step {0}'}" Style="{StaticResource Type.MonoStyle}" FontSize="10" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding ActionDescription}" Style="{StaticResource Type.BodyStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 6: Deterministic Replay & Envelope (Patent §27 & §28) -->
                        <TabItem Header="Replay &amp; Envelope">
                            <ScrollViewer Padding="14,12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="DETERMINISTIC REPLAY &amp; ENVELOPE" Style="{StaticResource Type.MicroLabelStyle}" />

                                    <WrapPanel Margin="0,8,0,12">
                                        <Button x:Name="BuildReplayPackageButton" Content="Compile Replay Package"
                                                Click="OnBuildReplayPackage" Style="{StaticResource Button.Primary}" Margin="0,0,8,4"
                                                ToolTip="Constructs formal Patent Table 49 Replay Package specification" />
                                        <Button x:Name="VerifyDeterminismButton" Content="Evaluate Replay Determinism"
                                                Click="OnVerifyDeterminism" Margin="0,0,0,4"
                                                ToolTip="Evaluates execution reproducibility outcome and derives Table 52 envelope" />
                                    </WrapPanel>

                                    <!-- Table 50 Outcome Badge Card -->
                                    <Border Margin="0,0,0,12" Padding="12" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="REPLAY OUTCOME (TABLE 50)" Style="{StaticResource Type.MicroLabelStyle}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" x:Name="ReplayOutcomeBadge" Padding="8,3" CornerRadius="4"
                                                        Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                                    <TextBlock x:Name="ReplayOutcomeText" Text="NOT EVALUATED" FontWeight="Bold" FontSize="10" Style="{StaticResource Type.MicroLabelStyle}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="ReplayOutcomeDetailText" Margin="0,6,0,0" Text="Click 'Compile Replay Package' to generate deterministic execution contract." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Table 52 Reproduction Envelope Card -->
                                    <TextBlock Text="REPRODUCTION ENVELOPE (TABLE 52)" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,12" Padding="10" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Reproducibility Score:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="ReproScoreText" Text="—" Style="{StaticResource Type.MonoStyle}" Foreground="{DynamicResource Authority.Clearance}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wilson 95% Confidence:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="ReproWilsonText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Attempts / Reproductions:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="ReproAttemptsText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Timing Range:" Style="{StaticResource Type.CaptionStyle}" />
                                                <TextBlock Grid.Column="1" x:Name="ReproTimingText" Text="—" Style="{StaticResource Type.MonoStyle}" />
                                            </Grid>
                                            <TextBlock x:Name="ReproConditionsText" Margin="0,6,0,0" Text="Envelope synthesizes conditions under which the failure holds still." Style="{StaticResource Type.CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Table 49 Replay Package YAML Preview -->
                                    <TextBlock Text="REPLAY PACKAGE SPECIFICATION (TABLE 49)" Style="{StaticResource Type.MicroLabelStyle}" />
                                    <Border Margin="0,6,0,0" Padding="8" Background="{DynamicResource Surface.Deep}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="4">
                                        <TextBox x:Name="ReplayPackageYamlText" Text="# Replay package will appear here"
                                                 IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource Text.Secondary}"
                                                 BorderThickness="0" TextWrapping="Wrap" FontFamily="{DynamicResource Font.Mono}" FontSize="10" MinHeight="140" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
