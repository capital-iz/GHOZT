<UserControl x:Class="Ghozt.App.Workspaces.SettingsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="20,18">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <!-- ============ APPEARANCE ============ -->
            <TextBlock Style="{StaticResource Type.SectionStyle}" Text="Appearance" />
            <TextBlock Style="{StaticResource Type.CaptionStyle}" Margin="0,4,0,0"
                       Text="Twelve palette identities, each in Dark, Light and System. A palette tints surfaces and actions; it never changes what verified, warning, fault, critical, AI or authority mean." />

            <!-- Live preview. The blueprint requires a theme change to preview on a representative
                 surface before it is applied everywhere; here the whole shell is the preview, and
                 this card shows the states that must stay distinguishable. -->
            <Border Margin="0,16,0,0" Padding="16"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.CardLarge}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="LIVE PREVIEW — SEMANTIC STATES" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource State.Verified}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                           Foreground="{DynamicResource State.Verified}" VerticalAlignment="Center" />
                                <TextBlock Text="Verified" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource State.Verified}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource State.Warning}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                           Foreground="{DynamicResource State.Warning}" VerticalAlignment="Center" />
                                <TextBlock Text="Review" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource State.Warning}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource State.Fault}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA39;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                           Foreground="{DynamicResource State.Fault}" VerticalAlignment="Center" />
                                <TextBlock Text="Fault" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource State.Fault}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource State.Critical}">
                            <TextBlock Text="Critical" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource State.Critical}" />
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource Ghozt.LiveBorder}">
                            <TextBlock Text="Live traversal" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ghozt.Live}" />
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}"
                                BorderThickness="1" BorderBrush="{DynamicResource Ghozt.CounterfactualBorder}">
                            <TextBlock Text="Counterfactual" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ghozt.Counterfactual}" />
                        </Border>
                        <Border Margin="0,0,8,8" Padding="8,4"
                                CornerRadius="{StaticResource Radius.SealChamfer}"
                                BorderThickness="1" BorderBrush="{DynamicResource Authority.Border}"
                                Background="{DynamicResource Authority.Soft}">
                            <TextBlock Text="Clearance authority" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Authority.Clearance}" />
                        </Border>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Primary action" MinWidth="130" />
                        <Button Margin="8,0,0,0" Content="Secondary" MinWidth="100" />
                        <Button Style="{StaticResource Button.Approval}" Margin="8,0,0,0" Content="Approve" MinWidth="110" />
                        <Button Style="{StaticResource Button.Destructive}" Margin="8,0,0,0" Content="Destroy" MinWidth="100" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource Surface.Inset}">
                        <TextBlock Style="{StaticResource Type.MonoStyle}"
                                   Text="14:26:41.881  EVT-0A92  UI.ACTION      click LoginButton     actor=AGT-04" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ MODE ============ -->
            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,20,0,6" Text="MODE" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeDark" Style="{StaticResource Toggle.Pill}" GroupName="Mode"
                             Content="Dark" MinWidth="86" Checked="OnModeChanged" Tag="Dark" />
                <RadioButton x:Name="ModeLight" Style="{StaticResource Toggle.Pill}" GroupName="Mode"
                             Margin="6,0,0,0" Content="Light" MinWidth="86" Checked="OnModeChanged" Tag="Light" />
                <RadioButton x:Name="ModeSystem" Style="{StaticResource Toggle.Pill}" GroupName="Mode"
                             Margin="6,0,0,0" Content="Match system" MinWidth="120" Checked="OnModeChanged" Tag="System" />
            </StackPanel>

            <!-- ============ PALETTES ============ -->
            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,20,0,6" Text="PALETTE" />
            <ItemsControl x:Name="Palettes">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ============ SURFACE OPACITY ============ -->
            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,22,0,6" Text="SURFACE OPACITY" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider" Minimum="35" Maximum="100"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnOpacityChanged"
                        AutomationProperties.Name="Surface opacity percentage" />
                <!-- The value is always shown: a slider without its number is an assertion without
                     evidence. -->
                <TextBlock Grid.Column="1" x:Name="OpacityValue" Margin="14,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource Type.MonoStyle}" />
            </Grid>
            <TextBlock Style="{StaticResource Type.MutedStyle}" Margin="0,4,0,0"
                       Text="How strongly the desktop shows through large surfaces. Text, borders and status colours stay fully opaque at every value — the contrast floor is held across the whole range." />

            <!-- ============ FINISH ============ -->
            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,22,0,6" Text="FINISH" />
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="GradientToggle" Content="Gradient wash" Click="OnFinishChanged"
                          Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center" />
                <CheckBox x:Name="GlassToggle" Content="Glass" Margin="20,0,0,0" Click="OnFinishChanged"
                          Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center" />
                <CheckBox x:Name="GlowToggle" Content="Accent glow" Margin="20,0,0,0" Click="OnFinishChanged"
                          Foreground="{DynamicResource Text.Body}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Direction" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" x:Name="DirectionSlider" Minimum="0" Maximum="360"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFinishChanged"
                        AutomationProperties.Name="Gradient direction in degrees" />
                <TextBlock Grid.Column="2" x:Name="DirectionValue" Style="{StaticResource Type.MonoStyle}"
                           VerticalAlignment="Center" TextAlignment="Right" />

                <TextBlock Grid.Row="1" Text="Intensity" Style="{StaticResource Type.CaptionStyle}"
                           VerticalAlignment="Center" Margin="0,10,0,0" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="IntensitySlider" Minimum="20" Maximum="80"
                        Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnFinishChanged"
                        AutomationProperties.Name="Gradient intensity percentage" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="IntensityValue" Margin="0,10,0,0"
                           Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" TextAlignment="Right" />

                <TextBlock Grid.Row="2" Text="Wash opacity" Style="{StaticResource Type.CaptionStyle}"
                           VerticalAlignment="Center" Margin="0,10,0,0" />
                <Slider Grid.Row="2" Grid.Column="1" x:Name="WashSlider" Minimum="25" Maximum="100"
                        Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnFinishChanged"
                        AutomationProperties.Name="Gradient opacity percentage" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="WashValue" Margin="0,10,0,0"
                           Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" TextAlignment="Right" />

                <TextBlock Grid.Row="3" Text="Blur" Style="{StaticResource Type.CaptionStyle}"
                           VerticalAlignment="Center" Margin="0,10,0,0" />
                <Slider Grid.Row="3" Grid.Column="1" x:Name="BlurSlider" Minimum="0" Maximum="40"
                        Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OnFinishChanged"
                        AutomationProperties.Name="Glass blur radius" />
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="BlurValue" Margin="0,10,0,0"
                           Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" TextAlignment="Right" />
            </Grid>

            <!-- ============ DENSITY AND MOTION ============ -->
            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,22,0,6" Text="DENSITY" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DensityCompact" Style="{StaticResource Toggle.Pill}" GroupName="Density"
                             Content="Compact" MinWidth="96" Checked="OnDensityChanged" Tag="Compact" />
                <RadioButton x:Name="DensityStandard" Style="{StaticResource Toggle.Pill}" GroupName="Density"
                             Margin="6,0,0,0" Content="Standard" MinWidth="96" Checked="OnDensityChanged" Tag="Standard" />
                <RadioButton x:Name="DensityComfortable" Style="{StaticResource Toggle.Pill}" GroupName="Density"
                             Margin="6,0,0,0" Content="Comfortable" MinWidth="110" Checked="OnDensityChanged" Tag="Comfortable" />
            </StackPanel>
            <TextBlock Style="{StaticResource Type.MutedStyle}" Margin="0,6,0,0"
                       Text="Density reflows target, risk and evidence information. It never removes it." />

            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,20,0,6" Text="MOTION" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="MotionFull" Style="{StaticResource Toggle.Pill}" GroupName="Motion"
                             Content="Full" MinWidth="86" Checked="OnMotionChanged" Tag="Full" />
                <RadioButton x:Name="MotionReduced" Style="{StaticResource Toggle.Pill}" GroupName="Motion"
                             Margin="6,0,0,0" Content="Reduced" MinWidth="96" Checked="OnMotionChanged" Tag="Reduced" />
                <RadioButton x:Name="MotionOff" Style="{StaticResource Toggle.Pill}" GroupName="Motion"
                             Margin="6,0,0,0" Content="Off" MinWidth="86" Checked="OnMotionChanged" Tag="Off" />
            </StackPanel>
            <TextBlock Style="{StaticResource Type.MutedStyle}" Margin="0,6,0,0"
                       Text="Every workflow stays fully operable with animation disabled. Traversal trails become static highlights and pulses become colour changes; nothing depends on motion to be legible." />

            <!-- ============ THEME DIGEST ============ -->
            <Border Margin="0,24,0,20" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource Surface.Inset}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="THEME DIGEST" />
                    <TextBlock x:Name="DigestText" Style="{StaticResource Type.MonoStyle}" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource Type.MutedStyle}" Margin="0,6,0,0"
                               Text="Recorded alongside screenshots and reports, so an image can be reproduced exactly. It carries the inputs, not the generated table — a digest holding the table would go stale the moment the generator improved." />
                </StackPanel>
            </Border>

            <!-- ============ STORAGE & DATABASE MAINTENANCE ============ -->
            <TextBlock Style="{StaticResource Type.SectionStyle}" Margin="0,10,0,0" Text="Storage &amp; Database Maintenance" />
            <TextBlock Style="{StaticResource Type.CaptionStyle}" Margin="0,4,0,0"
                       Text="Live SQLite Write-Ahead Log (WAL) forensics plane storing targets, sweeps, lattice topology, findings, evidence artefacts, and ledger events." />

            <Border Margin="0,14,0,0" Padding="16"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.CardLarge}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="SQLITE WAL DATA PLANE" />
                            <TextBlock x:Name="DbPathText" Style="{StaticResource Type.MonoStyle}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,4" CornerRadius="4" Background="{DynamicResource Surface.Inset}">
                            <TextBlock x:Name="DbSizeText" Style="{StaticResource Type.MonoStyle}" FontSize="11" />
                        </Border>
                    </Grid>

                    <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource Surface.Inset}">
                        <TextBlock x:Name="DbCountsText" Style="{StaticResource Type.MonoStyle}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="VerifyIntegrityButton" Style="{StaticResource Button.Primary}" Content="Verify Integrity" MinWidth="130"
                                Click="OnVerifyIntegrity"
                                ToolTip="Executes PRAGMA integrity_check across all b-trees and indexes"
                                AutomationProperties.Name="Verify SQLite database integrity" />
                        <Button x:Name="VacuumButton" Margin="8,0,0,0" Content="Vacuum &amp; Optimize" MinWidth="140"
                                Click="OnVacuumOptimize"
                                ToolTip="Reclaims unused disk space and truncates write-ahead log (WAL)"
                                AutomationProperties.Name="Vacuum and optimize database WAL" />
                        <Button x:Name="BackupButton" Margin="8,0,0,0" Content="Backup Database" MinWidth="130"
                                Click="OnBackupDatabase"
                                ToolTip="Creates a safe, timestamped atomic snapshot of the database in %LOCALAPPDATA%\Capital-Iz\Ghozt\Backups"
                                AutomationProperties.Name="Backup database to archive" />
                    </StackPanel>

                    <TextBlock x:Name="MaintenanceStatusText" Margin="0,10,0,0" Style="{StaticResource Type.CaptionStyle}" Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
            </Border>

            <!-- ============ EXECUTION SAFETY BOUNDARIES ============ -->
            <TextBlock Style="{StaticResource Type.SectionStyle}" Margin="0,24,0,0" Text="Execution &amp; Safety Boundaries" />
            <TextBlock Style="{StaticResource Type.CaptionStyle}" Margin="0,4,0,0"
                       Text="Runtime isolation levels, destructive action gates, and autonomous exploration state-space budgets." />

            <Border Margin="0,14,0,24" Padding="16"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.CardLarge}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="EXECUTION ISOLATION LEVEL" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="IsolationProcess" Style="{StaticResource Toggle.Pill}" GroupName="Isolation"
                                     Content="Isolated Process" MinWidth="130" Checked="OnIsolationChanged" Tag="IsolatedProcess" />
                        <RadioButton x:Name="IsolationAttached" Style="{StaticResource Toggle.Pill}" GroupName="Isolation"
                                     Margin="6,0,0,0" Content="Attached Monitor" MinWidth="130" Checked="OnIsolationChanged" Tag="AttachedMonitor" />
                        <RadioButton x:Name="IsolationPassive" Style="{StaticResource Toggle.Pill}" GroupName="Isolation"
                                     Margin="6,0,0,0" Content="Passive Observer" MinWidth="130" Checked="OnIsolationChanged" Tag="PassiveObserver" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,16,0,6" Text="DESTRUCTIVE ACTION GATE" />
                    <CheckBox x:Name="DestructiveInterlockToggle"
                              Content="Require typed interlock before invoking actions with destructive keywords (Delete, Format, Drop, Purge)"
                              Click="OnDestructiveGateChanged"
                              Foreground="{DynamicResource Text.Body}" />

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,16,0,6" Text="EXPLORATION STATE BUDGET" />
                    <Grid MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Default Max States" Style="{StaticResource Type.CaptionStyle}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="MaxStatesSlider" Minimum="10" Maximum="500"
                                IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="OnBudgetChanged"
                                AutomationProperties.Name="Default max states budget" />
                        <TextBlock Grid.Column="2" x:Name="MaxStatesValue" Style="{StaticResource Type.MonoStyle}"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="Default Max Depth" Style="{StaticResource Type.CaptionStyle}"
                                   VerticalAlignment="Center" Margin="0,10,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="MaxDepthSlider" Minimum="1" Maximum="50"
                                Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="OnBudgetChanged"
                                AutomationProperties.Name="Default max depth budget" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MaxDepthValue" Margin="0,10,0,0"
                                   Style="{StaticResource Type.MonoStyle}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
