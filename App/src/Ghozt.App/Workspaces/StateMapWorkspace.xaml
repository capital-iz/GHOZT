<UserControl x:Class="Ghozt.App.Workspaces.StateMapWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Ghozt.App.Shell">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20,10" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="VIEW" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <RadioButton x:Name="ViewGraph" Style="{StaticResource Toggle.Pill}" GroupName="View"
                                 Content="Lattice" MinWidth="74" Height="26" IsChecked="True" Checked="OnViewChanged" />
                    <RadioButton x:Name="ViewTree" Style="{StaticResource Toggle.Pill}" GroupName="View"
                                 Margin="6,0,0,0" Content="Tree" MinWidth="74" Height="26" Checked="OnViewChanged"
                                 ToolTip="The same graph as a keyboard-navigable tree" />

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                    <!-- Zoom Controls -->
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="ZOOM" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="BtnZoomOut" Content="−" Width="26" Height="26" Padding="0" Click="OnZoomOut"
                            ToolTip="Zoom Out" AutomationProperties.Name="Zoom Out" />
                    <TextBlock x:Name="ZoomLevelText" Text="100%" Style="{StaticResource Type.MonoStyle}"
                               VerticalAlignment="Center" Margin="6,0" MinWidth="38" TextAlignment="Center" />
                    <Button x:Name="BtnZoomIn" Content="+" Width="26" Height="26" Padding="0" Click="OnZoomIn"
                            ToolTip="Zoom In" AutomationProperties.Name="Zoom In" />
                    <Button x:Name="BtnZoomReset" Content="1:1" Height="26" Padding="6,0" Margin="4,0,0,0" Click="OnZoomReset"
                            ToolTip="Reset Zoom to 100%" AutomationProperties.Name="Reset Zoom" />
                    <Button x:Name="BtnZoomFit" Content="Fit" Height="26" Padding="6,0" Margin="4,0,0,0" Click="OnZoomFit"
                            ToolTip="Fit graph into viewport" AutomationProperties.Name="Fit Zoom" />

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                    <!-- State and Kind Filters -->
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="STATE" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="StateFilter" Width="96" Height="26" SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Verified" />
                        <ComboBoxItem Content="Observed" />
                        <ComboBoxItem Content="Deviation" />
                        <ComboBoxItem Content="Fault" />
                        <ComboBoxItem Content="Untested" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="KIND" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <ComboBox x:Name="KindFilter" Width="96" Height="26" SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Feature" />
                        <ComboBoxItem Content="Action" />
                        <ComboBoxItem Content="Endpoint" />
                        <ComboBoxItem Content="DataState" />
                    </ComboBox>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                    <!-- Autonomous Exploration & Truth Triangulation -->
                    <Button x:Name="BtnExplore" Content="Explore" Height="26" Padding="8,0" Click="OnExploreClick"
                            ToolTip="Run autonomous exploration step on frontier (Patent §16 &amp; §17)" AutomationProperties.Name="Explore Frontier" />
                    <Button x:Name="BtnTriangulate" Content="Triangulate" Height="26" Padding="8,0" Margin="4,0,0,0" Click="OnTriangulateClick"
                            ToolTip="Triangulate Intent, Source, and Runtime truth to detect contract drift (Patent §14 &amp; §15)" AutomationProperties.Name="Triangulate Truth" />
                    <Border x:Name="DriftBadgeBorder" Visibility="Collapsed" Margin="6,0,0,0" Background="{DynamicResource State.Warning}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="DriftBadgeText" Foreground="{DynamicResource Text.Primary}" Style="{StaticResource Type.MonoStyle}" FontSize="10" />
                    </Border>
                </StackPanel>

                <!-- The legend. A graph whose colours are not explained is decoration. -->
                <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource State.Verified}" VerticalAlignment="Center" />
                        <TextBlock Text="Verified" Margin="4,0,0,0" Style="{StaticResource Type.MutedStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ghozt.Live}" VerticalAlignment="Center" />
                        <TextBlock Text="Observed" Margin="4,0,0,0" Style="{StaticResource Type.MutedStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource State.Warning}" VerticalAlignment="Center" />
                        <TextBlock Text="Deviation" Margin="4,0,0,0" Style="{StaticResource Type.MutedStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource State.Fault}" VerticalAlignment="Center" />
                        <TextBlock Text="Fault" Margin="4,0,0,0" Style="{StaticResource Type.MutedStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Stroke="{DynamicResource Text.Muted}" StrokeThickness="1"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Untested" Margin="4,0,0,0" Style="{StaticResource Type.MutedStyle}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Grid.Column="2" x:Name="Coverage" Style="{StaticResource Type.MonoStyle}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- The lattice canvas. Interactive vector canvas with zoom and pan. -->
            <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="CanvasContainer" Background="Transparent"
                      MouseWheel="OnCanvasMouseWheel"
                      MouseDown="OnCanvasMouseDown"
                      MouseMove="OnCanvasMouseMove"
                      MouseUp="OnCanvasMouseUp">
                    <Canvas x:Name="Lattice" Width="1300" Height="750" Background="Transparent">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LatticeScale" ScaleX="1.0" ScaleY="1.0" />
                                <TranslateTransform x:Name="LatticeTranslate" X="0" Y="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- The synchronised tree. The blueprint requires a keyboard-navigable representation of
                 the same graph, not a different dataset. -->
            <TreeView x:Name="Tree" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                      Padding="20,14" SelectedItemChanged="OnTreeSelect"
                      AutomationProperties.Name="State lattice as a tree" />

            <Border Style="{StaticResource Surface.EmptySlot}" MaxWidth="560" Margin="0,40,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center" x:Name="EmptyPanel">
                <StackPanel>
                    <TextBlock Text="&#xE81E;" FontFamily="{StaticResource Font.Icon}" FontSize="22"
                               Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource Type.SectionStyle}" />
                    <TextBlock x:Name="EmptyBody" Margin="0,8,0,0" TextAlignment="Center"
                               Style="{StaticResource Type.CaptionStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
