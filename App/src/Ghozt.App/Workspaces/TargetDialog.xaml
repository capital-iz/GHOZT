<Window x:Class="Ghozt.App.Workspaces.TargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="600" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Register target">

    <Border Background="{DynamicResource Surface.Dialog}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,20,24,16"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDrag">
                <StackPanel>
                    <TextBlock Text="Register target" Style="{StaticResource Type.SectionStyle}"
                               Foreground="{DynamicResource Accent.Text}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Type.CaptionStyle}"
                               Text="Identify what Ghozt will examine, where it runs, and the authority you hold over it. Access class and environment govern what may be executed." />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="24,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="QUICK PRESETS" />
                    <WrapPanel Margin="0,4,0,14">
                        <Button Content="Android Mobile (AVD)" Click="OnPresetMobile" Height="24" Padding="8,2" Margin="0,0,6,6"
                                ToolTip="Auto-fill Android emulator/mobile target profile"
                                AutomationProperties.Name="Preset Android Mobile" />
                        <Button Content="Windows Desktop" Click="OnPresetDesktop" Height="24" Padding="8,2" Margin="0,0,6,6"
                                ToolTip="Auto-fill Windows desktop WPF/Win32 target profile"
                                AutomationProperties.Name="Preset Windows Desktop" />
                        <Button Content="Scientific Math Engine" Click="OnPresetMath" Height="24" Padding="8,2" Margin="0,0,6,6"
                                ToolTip="Auto-fill high-performance physics/math engine target profile"
                                AutomationProperties.Name="Preset Scientific Math" />
                        <Button Content="Agentic AI / UTCP System" Click="OnPresetAi" Height="24" Padding="8,2" Margin="0,0,6,6"
                                ToolTip="Auto-fill Agentic AI, LLM harness, and UTCP tool orchestrator target profile"
                                AutomationProperties.Name="Preset Agentic AI" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="NAME" />
                    <TextBox x:Name="NameBox" AutomationProperties.Name="Target name" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="KIND" />
                            <ComboBox x:Name="KindBox" IsEditable="True" AutomationProperties.Name="Target kind">
                                <ComboBoxItem Content="Desktop application" />
                                <ComboBoxItem Content="Web application" />
                                <ComboBoxItem Content="HTTP API" />
                                <ComboBoxItem Content="Service" />
                                <ComboBoxItem Content="Algorithm" />
                                <ComboBoxItem Content="Database" />
                                <ComboBoxItem Content="Mobile application" />
                                <ComboBoxItem Content="Scientific Math Engine" />
                                <ComboBoxItem Content="Machine learning model / AI Agent" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="OWNER" />
                            <TextBox x:Name="OwnerBox" AutomationProperties.Name="Target owner" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="ENVIRONMENT" />
                            <ComboBox x:Name="EnvironmentBox" SelectionChanged="OnEnvironmentChanged"
                                      AutomationProperties.Name="Environment" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="ACCESS CLASS" />
                            <ComboBox x:Name="AccessBox" SelectionChanged="OnAccessChanged"
                                      AutomationProperties.Name="Access class" />
                        </StackPanel>
                    </Grid>

                    <!-- The consequence of the two choices above, stated before the target exists
                         rather than discovered when an action is refused. -->
                    <Border x:Name="PolicyNote" Margin="0,12,0,0" Padding="10,8"
                            BorderThickness="2,0,0,0"
                            BorderBrush="{DynamicResource State.Warning}">
                        <TextBlock x:Name="PolicyText" Style="{StaticResource Type.CaptionStyle}" />
                    </Border>

                    <Grid Margin="0,16,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="BASE ADDRESS OR PATH" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Attach Process..." Click="OnAttachProcess" Height="22" Padding="8,0" Margin="0,0,6,0"
                                    ToolTip="Select a running desktop application to auto-fill metadata"
                                    AutomationProperties.Name="Attach running process" />
                            <Button Content="Browse File..." Click="OnBrowseFile" Height="22" Padding="8,0" Margin="0,0,6,0"
                                    ToolTip="Select an executable, assembly, database, or document"
                                    AutomationProperties.Name="Browse for file" />
                            <Button Content="Browse Folder..." Click="OnBrowseAddressFolder" Height="22" Padding="8,0"
                                    ToolTip="Select a root directory or endpoint directory"
                                    AutomationProperties.Name="Browse for address folder" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="AddressBox"
                             ToolTip="An http(s) URL, or a file or folder path. Used by the capability probe."
                             AutomationProperties.Name="Base address or path" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="BUILD LABEL" />
                            <TextBox x:Name="BuildBox"
                                     ToolTip="A version, commit or package identifier. Findings are recorded against it."
                                     AutomationProperties.Name="Build label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="REPOSITORY PATH" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Browse..." Click="OnBrowseRepository" Height="20" Padding="6,0"
                                        ToolTip="Select the source repository folder for behavioural manifest discovery"
                                        AutomationProperties.Name="Browse repository folder" />
                            </Grid>
                            <TextBox x:Name="RepositoryBox" AutomationProperties.Name="Repository path" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Margin="0,16,0,4"
                               Text="AUTHORITY GRANT" />
                    <TextBox x:Name="AuthorityBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="66" VerticalContentAlignment="Top" Padding="10,8"
                             ToolTip="Who authorised which actions, against which environment, for what period."
                             AutomationProperties.Name="Authority grant" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Type.MutedStyle}"
                               Text="Ghozt operates only against targets and actions for which you hold explicit permission. Without a grant, the target is observation-only." />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource Surface.Inset}"
                    CornerRadius="0,0,19,19">
                <Grid>
                    <TextBlock x:Name="Validation" VerticalAlignment="Center"
                               Style="{StaticResource Type.MutedStyle}"
                               Foreground="{DynamicResource State.Warning}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancel" />
                        <Button x:Name="RegisterButton" Style="{StaticResource Button.Primary}"
                                Margin="10,0,0,0" MinWidth="130" Content="Register" Click="OnRegister" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
