<UserControl x:Class="Ghozt.App.Workspaces.TargetsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Ghozt.App.Shell">

    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <shell:IsEmptyConverter x:Key="IsEmpty" />
        <shell:TargetActiveBorderConverter x:Key="TargetActiveBorder" />
        <shell:TargetActiveVisibilityConverter x:Key="TargetActiveVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar. Exactly one accent-filled control: the screen's primary action. -->
        <Border Grid.Row="0" Padding="20,10"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Content="Register target"
                            Click="OnRegister"
                            AutomationProperties.Name="Register a new target" />
                    <Button Margin="8,0,0,0" Content="Probe capability" Click="OnProbe"
                            IsEnabled="{Binding HasTarget}"
                            ToolTip="Check whether the selected target is reachable and record the result"
                            AutomationProperties.Name="Probe the selected target" />
                    <Button Margin="8,0,0,0" Content="Authority Grant" Click="OnToolbarAuthorityGrant"
                            IsEnabled="{Binding HasTarget}"
                            ToolTip="Issue or manage execution authority grant and isolation level (L0-L5) for selected target"
                            AutomationProperties.Name="Manage target authority grant" />
                    <Button Margin="8,0,0,0" Content="Discover Manifest" Click="OnDiscoverManifest"
                            IsEnabled="{Binding HasTarget}"
                            ToolTip="Scans the target repository/address for feature manifests and maps them into the State Lattice"
                            AutomationProperties.Name="Discover target behavioural manifest" />
                    <Button Margin="8,0,0,0" Content="Attach Process" Click="OnAttachProcess"
                            ToolTip="Select and attach an active Windows desktop application process as a target"
                            AutomationProperties.Name="Attach an active desktop process" />
                    <Button Margin="8,0,0,0" Content="Register Local System" Click="OnRegisterLocalHost"
                            ToolTip="Registers Ghozt's local evidence store and host subsystem as an operational target"
                            AutomationProperties.Name="Register local system target" />
                    <Button x:Name="PruneCanariesButton" Margin="8,0,0,0" Content="Prune Canaries" Click="OnPruneCanaries"
                            ToolTip="Safely prunes ephemeral test canary targets from the evidence store"
                            AutomationProperties.Name="Prune ephemeral canary targets" />
                    <Button Style="{StaticResource Button.Destructive}" Margin="16,0,0,0"
                            Content="Remove target" Click="OnRemove"
                            IsEnabled="{Binding HasTarget}"
                            ToolTip="Permanently removes the target and everything recorded against it"
                            AutomationProperties.Name="Remove the selected target and its records" />
                </StackPanel>

                <!-- Search and Filter on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="FILTER" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SearchBox" Width="130" Height="26" Margin="0,0,8,0"
                             TextChanged="OnSearchChanged"
                             ToolTip="Filter targets by name or address"
                             AutomationProperties.Name="Filter targets" />
                    <ComboBox x:Name="KindFilter" Width="120" Height="26"
                              SelectionChanged="OnKindFilterChanged" VerticalAlignment="Center"
                              AutomationProperties.Name="Filter by kind">
                        <ComboBoxItem Content="All Kinds" IsSelected="True" />
                        <ComboBoxItem Content="Desktop application" />
                        <ComboBoxItem Content="SQLite database" />
                        <ComboBoxItem Content="API service" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="OperationsColumn" Width="480" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Target Cards List -->
            <ScrollViewer Grid.Column="0" Padding="20,16" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl x:Name="TargetsList" ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A target card. Every reading that gates what may be done is on the
                                     card, not behind a click: environment, access class, authority. -->
                                <Border Width="400" Margin="0,0,14,14" Padding="14"
                                        Background="{DynamicResource Surface.Card}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource Radius.CardLarge}"
                                        MouseLeftButtonUp="OnSelectTarget"
                                        Cursor="Hand">
                                    <Border.BorderBrush>
                                        <MultiBinding Converter="{StaticResource TargetActiveBorder}">
                                            <Binding Path="Id" />
                                            <Binding Path="DataContext.Target" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Border.BorderBrush>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Type.HeadingStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource Type.IdentifierStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="8,3" VerticalAlignment="Top"
                                                    CornerRadius="{StaticResource Radius.Chip}"
                                                    Background="{DynamicResource Accent.Fill}">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource TargetActiveVisibility}">
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.Target" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource Text.OnAccent}" />
                                            </Border>
                                        </Grid>

                                        <!-- Chips row for Kind and Reachability -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                            <Border Padding="6,2" Margin="0,0,6,0"
                                                    CornerRadius="{StaticResource Radius.Chip}"
                                                    Background="{DynamicResource Surface.Inset}">
                                                <TextBlock Text="{Binding Kind}" FontSize="9"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                            </Border>
                                            <Border Padding="6,2"
                                                    CornerRadius="{StaticResource Radius.Chip}"
                                                    Background="{DynamicResource Surface.Inset}">
                                                <TextBlock Text="{Binding Reachable, StringFormat='Reachable: {0}'}" FontSize="9"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                            </Border>
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <shell:StatusPlate Label="ENVIRONMENT" Value="{Binding Environment}" Strong="True" />
                                            <shell:StatusPlate Label="ACCESS" Value="{Binding Access}" Strong="True" />
                                        </StackPanel>

                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Type.MutedStyle}"
                                                   Text="{Binding BaseAddress}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Authority is stated or its absence is stated. An empty
                                             authority note is not a blank space; it is a condition. -->
                                        <Border Margin="0,10,0,0" Padding="8,6"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{DynamicResource Authority.Border}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Type.CaptionStyle}">
                                                        <Setter Property="Text" Value="{Binding AuthorityNote}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AuthorityNote}" Value="">
                                                                <Setter Property="Text" Value="No authority grant recorded — Ghozt will observe only." />
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Direct Target Control & Navigation Actions -->
                                        <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
                                            <UniformGrid Columns="4">
                                                <Button Content="Launch" Height="26" Padding="4,0" FontSize="11" Margin="0,0,4,0"
                                                        Click="OnLaunchTarget" ToolTip="Launch target executable or verify running process"
                                                        AutomationProperties.Name="Launch target" />
                                                <Button Content="Lattice" Height="26" Padding="4,0" FontSize="11" Margin="0,0,4,0"
                                                        Click="OnExploreTargetLattice" ToolTip="Jump to State Lattice for this target"
                                                        AutomationProperties.Name="Open State Lattice" />
                                                <Button Content="Sweep" Height="26" Padding="4,0" FontSize="11" Margin="0,0,4,0"
                                                        Click="OnSweepTarget" ToolTip="Open sweep runner for this target"
                                                        AutomationProperties.Name="Open sweep runner" />
                                                <Button Content="Clearance" Height="26" Padding="4,0" FontSize="11"
                                                        Click="OnClearanceTarget" ToolTip="Jump to release policy clearance for this target"
                                                        AutomationProperties.Name="Open clearance" />
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state: explains what a target is and offers the next valid action -->
                    <Border x:Name="EmptyState" Style="{StaticResource Surface.EmptySlot}" MaxWidth="560" Margin="0,40,0,0"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Visibility="{Binding Targets.Count, Converter={StaticResource IsEmpty}}">
                        <StackPanel>
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource Font.Icon}" FontSize="24"
                                       Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource Type.SectionStyle}" Text="No targets registered" />
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource Type.CaptionStyle}"
                                       Text="A target is the application, service, algorithm or system Ghozt will examine — together with the environment it runs in and the authority you hold to examine it. Nothing runs until one exists." />
                            <Button Style="{StaticResource Button.Primary}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Content="Register your first target"
                                    Click="OnRegister" />
                        </StackPanel>
                    </Border>

                    <!-- Filter empty state: gives clear feedback when filters exclude all targets -->
                    <Border x:Name="FilterEmptyState" Style="{StaticResource Surface.EmptySlot}" MaxWidth="560" Margin="0,40,0,0"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="24"
                                       Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource Type.SectionStyle}" Text="No matching targets" />
                            <TextBlock x:Name="FilterEmptyDetail" Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource Type.CaptionStyle}"
                                       Text="No registered targets match the current query or kind filter." />
                            <Button Margin="0,16,0,0" Padding="14,6"
                                    HorizontalAlignment="Center" Content="Clear filter"
                                    Click="OnClearFilter" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Column 1: Target Operations Mission-Control Console -->
            <Border Grid.Column="1" x:Name="TargetOperationsPanel"
                    Background="{DynamicResource Surface.PanelDeep}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OpDetailContainer">
                        <!-- Header & Identification -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="TARGET OPERATIONS CONSOLE" Foreground="{DynamicResource Accent.Text}" />
                                <TextBlock x:Name="OpTargetName" Text="{Binding Target.Name}" Style="{StaticResource Type.TitleStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OpTargetId" Text="{Binding Target.Id}" Style="{StaticResource Type.IdentifierStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,4" CornerRadius="{StaticResource Radius.Chip}" Background="{DynamicResource Accent.Fill}" VerticalAlignment="Top">
                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text.OnAccent}" />
                            </Border>
                        </Grid>

                        <!-- Host & Runtime Telemetry Card -->
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="RUNTIME &amp; CONNECTIVITY TELEMETRY" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Endpoint Address" Style="{StaticResource Type.CaptionStyle}" />
                                        <TextBlock x:Name="OpBaseAddress" Text="{Binding Target.BaseAddress}" Style="{StaticResource Type.MonoStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="6,2" CornerRadius="{StaticResource Radius.Chip}" Background="{DynamicResource Surface.Inset}" VerticalAlignment="Center">
                                        <TextBlock x:Name="OpReachableText" Text="Reachable" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource State.Verified}" />
                                    </Border>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Environment" Style="{StaticResource Type.CaptionStyle}" />
                                        <TextBlock x:Name="OpEnvironment" Text="{Binding Target.Environment}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Access Mode" Style="{StaticResource Type.CaptionStyle}" />
                                        <TextBlock x:Name="OpAccess" Text="{Binding Target.Access}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Exploration & State Lattice Metrics Card -->
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="BEHAVIOURAL LATTICE &amp; EVIDENCE (PATENT §14)" />
                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource Surface.Inset}" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="OpNodesCount" Text="0" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Nodes" Style="{StaticResource Type.MicroLabelStyle}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface.Inset}" CornerRadius="4" Padding="8,6" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="OpEdgesCount" Text="0" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Edges" Style="{StaticResource Type.MicroLabelStyle}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface.Inset}" CornerRadius="4" Padding="8,6" Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="OpDeviationsCount" Text="0" Style="{StaticResource Type.HeadingStyle}" Foreground="{DynamicResource State.Fault}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Faults" Style="{StaticResource Type.MicroLabelStyle}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Surface.Inset}" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="OpEvidenceCount" Text="0" Style="{StaticResource Type.HeadingStyle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Evidence" Style="{StaticResource Type.MicroLabelStyle}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Governance & Authority Note -->
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="GOVERNANCE &amp; AUTHORITY ENVELOPE (PATENT §08)" />
                                <TextBlock x:Name="OpAuthorityNote" Text="{Binding Target.AuthorityNote}" Style="{StaticResource Type.CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Border Margin="0,10,0,0" Padding="8,4" CornerRadius="4" x:Name="OpClearanceVerdictBadge" Background="{DynamicResource State.CriticalSoft}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="11" Foreground="{DynamicResource State.Critical}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="OpClearanceVerdictText" Text="Clearance: In Review" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource State.Critical}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Direct Mission Action Launchpad -->
                        <Border Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.MicroLabelStyle}" Text="MISSION CONTROL LAUNCHPAD" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Run Sweep" Height="28" Margin="0,0,4,0" Click="OnOpRunSweep"
                                            ToolTip="Open sweep runner for active target" AutomationProperties.Name="Run sweep for active target" />
                                    <Button Grid.Column="1" Content="State Lattice" Height="28" Margin="4,0,0,0" Click="OnOpExploreLattice"
                                            ToolTip="Explore connected state lattice" AutomationProperties.Name="Explore state lattice for active target" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Triage Faults" Height="28" Margin="0,0,4,0" Click="OnOpTriageFaults"
                                            ToolTip="Review confirmed deviations" AutomationProperties.Name="Triage faults for active target" />
                                    <Button Grid.Column="1" Content="Evidence Vault" Height="28" Margin="4,0,0,0" Click="OnOpViewEvidence"
                                            ToolTip="Inspect captured evidence artefacts" AutomationProperties.Name="View evidence vault for active target" />
                                </Grid>
                                <Button Content="Generate Clearance Dossier" Height="28" Click="OnOpClearanceDossier"
                                        Style="{StaticResource Button.Primary}"
                                        ToolTip="Produce comprehensive certification dossier" AutomationProperties.Name="Generate clearance dossier" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
